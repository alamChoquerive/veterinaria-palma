# ── Supabase ──────────────────────────────────────────────
# Se consiguen en: Proyecto Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# SOLO servidor (webhooks, admin). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Mercado Pago ──────────────────────────────────────────
# Credenciales de prueba en: Mercado Pago → Tus integraciones → Credenciales
MERCADOPAGO_ACCESS_TOKEN=<access-token>
MERCADOPAGO_WEBHOOK_SECRET=<webhook-secret>
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=<public-key>

# Copiar este archivo a ".env.local" y completar los valores.
# .env.local está ignorado por git (ver .gitignore).
